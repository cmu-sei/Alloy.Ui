{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "alloy": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "app",
      "schematics": {},
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/"
            },
            "index": "src/index.html",
            "polyfills": ["@angular/localize/init", "zone.js"],
            "tsConfig": "src/tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "auth-callback-silent.html",
                "input": "node_modules/@cmusei/crucible-common/src/lib/comn-auth/assets/",
                "output": "/"
              }
            ],
            "styles": [
              "src/styles/styles.scss",
              "./node_modules/bootstrap/scss/bootstrap-utilities.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles", "./node_modules/bootstrap/scss"]
            },
            "scripts": [],
            "preserveSymlinks": true,
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": {
                "scripts": true,
                "styles": true,
                "vendor": true
              },
              "namedChunks": true
            },
            "localNPM": {
              "tsConfig": "tsconfig.local-npm.json"
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4403,
            "buildTarget": "alloy:build"
          },
          "defaultConfiguration": "development",
          "configurations": {
            "production": {
              "buildTarget": "alloy:build:production"
            },
            "development": {
              "buildTarget": "alloy:build:development"
            },
            "localNPM": {
              "buildTarget": "alloy:build:development,localNPM"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "alloy:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runnerConfig": "vitest.config.ts",
            "tsConfig": "tsconfig.spec.json",
            "setupFiles": ["src/test-setup.ts"],
            "coverageInclude": ["src/app/**/*.ts"],
            "coverageExclude": [
              "**/generated/**",
              "**/*.spec.ts",
              "src/app/test-utils/**"
            ],
            "coverageReporters": ["text", "json", "html"],
            "coverageThresholds": {
              "statements": 88,
              "branches": 77,
              "functions": 88,
              "lines": 87
            }
          },
          "configurations": {
            "coverage": {
              "coverage": true
            }
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": ["src/tsconfig.app.json", "src/tsconfig.spec.json"],
            "exclude": ["**/node_modules/**"]
          }
        }
      }
    },
    "alloy-e2e": {
      "root": "e2e/",
      "projectType": "application",
      "prefix": "",
      "architect": {
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "alloy:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "alloy:serve:production"
            }
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": "e2e/tsconfig.e2e.json",
            "exclude": ["**/node_modules/**"]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
